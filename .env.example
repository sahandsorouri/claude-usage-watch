# Telegram delivery (optional). The bot only sends; it never reads messages.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# File delivery (optional): one text file per alert in this folder.
OUTBOX_DIR=

# Where to write the gauge JSON (optional, comma separated for several copies).
JSON_OUTPUT=/path/to/claude-usage.json

# Local time zone for the daily report and dates (IANA name). Default UTC.
USAGE_TZ=UTC
# Hour of the daily report in USAGE_TZ. Default 8.
DAILY_HOUR=8
# Alert language: en (default) or fa (Persian).
ALERT_LANG=en

# Optional overrides.
CLAUDE_CREDENTIALS=~/.claude/.credentials.json
STATE_DIR=~/.local/state/claude-usage-watch
